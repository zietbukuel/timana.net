---
import '../styles/global.css';
import PageContainer from '../components/PageContainer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Juan Timaná | Senior Full Stack Web Developer & Systems Engineer</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Juan Timaná is a Senior Full Stack Web Developer & Systems Engineer with over a decade of experience building reliable web applications, managing backend logic (Laravel, Drupal, WordPress), and server infrastructure provisioning." />
    <meta name="keywords" content="Juan Timaná, Full Stack Developer, Systems Engineer, Laravel, Drupal, WordPress, Devops, Lima Peru, Web Architect" />
    <meta name="author" content="Juan Timaná" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Juan Timaná | Senior Full Stack Web Developer & Systems Engineer" />
    <meta property="og:description" content="Seasoned full-stack engineer specializing in Laravel, Drupal, WordPress module engineering, server provisioning, and high-performance automated pipelines." />
    <meta property="og:image" content="/img/me.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="Juan Timaná | Senior Full Stack Web Developer & Systems Engineer" />
    <meta property="twitter:description" content="Seasoned full-stack engineer specializing in Laravel, Drupal, WordPress module engineering, server provisioning, and high-performance automated pipelines." />
    <meta property="twitter:image" content="/img/me.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css?family=PT+Sans:400,700|Merriweather:400italic,400" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="shortcut icon" href="/img/favicon.png" />
  </head>
  <body>
    <h1 class="sr-only">Juan Timaná | Senior Full Stack Web Developer & Systems Engineer Portfolio</h1>
    <main>
      <PageContainer client:load />
    </main>
  </body>
</html>
